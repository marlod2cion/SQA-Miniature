.env
.env.*
!.env.example
!.env.*.example

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
